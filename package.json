{
	"name": "kitscrobbler",
	"version": "1.0.2",
	"private": true,
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/mountainash/KitScrobbler.git"
	},
	"author": {
		"name": "Mountain/\\Ash",
		"url": "https://mountainash.id.au/"
	},
	"scripts": {
		"dev": "bun --hot scripts/dev.ts",
		"build": "bun run scripts/build.ts",
		"build:release": "bun run scripts/build.ts --no-dev",
		"build:ui": "bun run scripts/build-ui.ts",
		"bundle": "bun run scripts/bundle.ts",
		"check": "tsc --noEmit && biome check",
		"fix": "biome lint --write",
		"guard": "bun run scripts/guard-submodule.ts",
		"postinstall": "bun run scripts/setup.ts",
		"prepare": "husky"
	},
	"dependencies": {
		"@phosphor-icons/web": "^2.1.2",
		"webextension-polyfill": "0.12.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/blueimp-md5": "2.18.2",
		"@types/bun": "1.4.2",
		"@types/webextension-polyfill": "0.12.6",
		"husky": "9.1.7",
		"typescript": "7.0.2"
	},
	"packageManager": "bun@1.4.2",
	"engines": {
		"bun": ">=1.4.2"
	},
	"allowScripts": {
		"husky": true
	}
}
