{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "Preserve",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"paths": {
			"@kit/*": ["./app/*"],
			"@upstream": ["./src/web-scrobbler"],
			"@upstream/*": ["./src/web-scrobbler/*"],
			"@/*": ["./src/web-scrobbler/src/*"]
		}
	},
	"include": ["app/**/*", "scripts/**/*"],
	"exclude": ["node_modules", "build", "dist", "src/web-scrobbler/build"]
}
