{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"**",
			"!src/web-scrobbler",
			"!build",
			"!dist",
			"!.devcontainer",
			"!.vscode"
		]
	},
	"javascript": {
		"globals": ["Bun", "process"]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"style": {
				"noDescendingSpecificity": "warn"
			}
		}
	},
	"overrides": [
		{
			"includes": ["app/**/*", "scripts/**/*"]
		}
	],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	}
}
